class Solution {
    public int gcdOfOddEvenSums(int n) {
       
        int sum1 = n * n;          // Sum of first n odd numbers
        int sum2 = n * (n + 1);    // Sum of first n even numbers

        while (sum2 != 0) {
            int temp = sum2;
            sum2 = sum1 % sum2;
            sum1 = temp;
        }

        return sum1;
    }
}
class main{
    public static void main(String args[]){
        Solution obj= new Solution();
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        System.out.print(obj.gcdOfOddEvenSums(n));

    }
}
